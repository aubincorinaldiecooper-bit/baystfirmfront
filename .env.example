# BayAnalytics web frontend — server-side configuration.
#
# Both variables are read only by the Next.js server (the /api/bay proxy).
# They are deliberately NOT prefixed with NEXT_PUBLIC_ and must never be:
# the browser never talks to the backend directly and never sees the key.

# Base URL of the BayAnalytics API, including the versioned prefix.
# Local backend (bayanalytics serve binds 127.0.0.1:8000):
BAY_API_URL=http://127.0.0.1:8000/api/v1

# API key the proxy sends as "Authorization: Bearer <key>". A loopback-bound
# backend needs no key; a backend bound to any other host requires one.
BAY_API_KEY=
